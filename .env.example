# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES (Vite / Public)
# ==============================================================================
# VITE_GAS_TH_URL: Public Webhook URL for Thai-language workshops (preserves legacy direct dispatch)
VITE_GAS_TH_URL="https://script.google.com/macros/s/AKfycbyk4505Uis2F-0fKsX7X9iuDsrOfB7aPyD_TO00JUq_BMi9ZDUBzjSKFOFsNHrSVVxN/exec"

# ==============================================================================
# SERVER-ONLY ENVIRONMENT VARIABLES (Netlify Functions Dashboard)
# CRITICAL: Never prefix these with VITE_. Configure these in Netlify Site Settings.
# NOTE ON NETLIFY PLAN: Operates within the Netlify Personal Plan allocation of
# 1,000 compute credits/month. LDO registration notification volume (~150-500 runs/mo)
# consumes ~10-35 compute credits/month (<3.5% of quota) at zero extra cost.
# ==============================================================================
# GAS_EN_URL: The deployed Google Apps Script Web App URL for the English gateway
GAS_EN_URL="https://script.google.com/macros/s/YOUR_ENGLISH_GAS_DEPLOYMENT_ID/exec"

# GAS_EN_SECRET: Shared secret matching INTERNAL_WEBHOOK_SECRET in Apps Script Properties
GAS_EN_SECRET="YOUR_STRONG_RANDOM_32_CHAR_SECRET_HERE"

# FIREBASE_SERVICE_ACCOUNT: Firebase Service Account JSON string for token verification and Firestore access
# (Must be under Netlify's 4KB variable limit; minified JSON is ~2.3KB)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"my-bu-app-2026-d4620","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# ALTERNATIVE GRANULAR CREDENTIALS (if avoiding single large JSON string):
# FIREBASE_PROJECT_ID="my-bu-app-2026-d4620"
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-...@my-bu-app-2026-d4620.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
