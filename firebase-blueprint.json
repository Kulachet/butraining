{
  "entities": {
    "instructors": {
      "title": "Instructor",
      "description": "A Bangkok University instructor profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Full name in Thai" },
        "email": { "type": "string", "format": "email", "description": "BU email address (@bu.ac.th)" },
        "position": { "type": "string", "description": "Academic position" },
        "department": { "type": "string", "description": "Department or Faculty" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Registration timestamp" }
      },
      "required": ["uid", "name", "email", "position", "department"]
    },
    "courses": {
      "title": "Course",
      "description": "A training course offered by the portal.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique course ID" },
        "title": { "type": "string", "description": "Course title" },
        "instructorName": { "type": "string", "description": "Name of the instructor teaching the course" },
        "date": { "type": "string", "description": "Training date" },
        "time": { "type": "string", "description": "Training time" },
        "location": { "type": "string", "description": "Training location" },
        "description": { "type": "string", "description": "Brief course description" },
        "imageUrl": { "type": "string", "description": "Course thumbnail URL" },
        "driveFolderId": { "type": "string", "description": "Google Drive Folder ID for certificates" }
      },
      "required": ["title", "instructorName", "date"]
    },
    "registrations": {
      "title": "Registration",
      "description": "A course registration or walk-in attendance record.",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "source": { "type": "string", "enum": ["online", "walk_in"] },
        "userId": { "type": "string" },
        "instructorId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "userPosition": { "type": "string" },
        "userDepartment": { "type": "string" },
        "sequenceNumber": { "type": "integer" },
        "attended": { "type": "boolean" },
        "registeredAt": { "type": "string", "format": "date-time" },
        "createdByAdminUid": { "type": "string" }
      },
      "required": ["courseId", "userName", "userEmail", "sequenceNumber", "attended"]
    },
    "mail": {
      "title": "Mail",
      "description": "Email queue for Firebase Trigger Email extension.",
      "type": "object",
      "properties": {
        "to": { "type": "string" },
        "message": {
          "type": "object",
          "properties": {
            "subject": { "type": "string" },
            "html": { "type": "string" },
            "attachments": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    },
    "evaluations": {
      "title": "Evaluation",
      "description": "User feedback for a course.",
      "type": "object",
      "properties": {
        "courseId": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "ratings": { "type": "object" },
        "suggestion": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["courseId", "userId", "ratings"]
    },
    "settings": {
      "title": "Settings",
      "description": "Global application settings.",
      "type": "object",
      "properties": {
        "evaluationQuestions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "admins": {
      "title": "Admin",
      "description": "Administrative authority registry keyed by UID.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "Admin email address" },
        "active": { "type": "boolean", "description": "Active status of administrative privileges" },
        "role": { "type": "string", "description": "Administrative role identifier" }
      },
      "required": ["email", "active"]
    },
    "promotion_campaigns": {
      "title": "PromotionCampaign",
      "description": "Course promotional email campaign configuration and aggregate delivery tracking.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "language": { "type": "string", "enum": ["th", "en"] },
        "subject": { "type": "string" },
        "registrationUrl": { "type": "string" },
        "posterMode": { "type": "string", "enum": ["course_url", "custom_url", "inline_cid", "none"] },
        "posterUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "ready", "sending", "paused", "completed", "completed_with_issues"] },
        "totalRecipients": { "type": "integer" },
        "sentCount": { "type": "integer" },
        "failedCount": { "type": "integer" },
        "pendingCount": { "type": "integer" },
        "unknownCount": { "type": "integer" },
        "skippedCount": { "type": "integer" },
        "suppressedCount": { "type": "integer" },
        "createdByAdminUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["courseId", "language", "subject", "registrationUrl", "status", "totalRecipients", "createdByAdminUid"]
    },
    "promotion_campaign_recipients": {
      "title": "PromotionCampaignRecipient",
      "description": "Per-recipient delivery state for a promotional campaign.",
      "type": "object",
      "properties": {
        "campaignId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "department": { "type": "string" },
        "source": { "type": "string", "enum": ["paste", "csv", "instructor"] },
        "status": { "type": "string", "enum": ["pending", "processing", "sent", "failed", "unknown", "skipped"] },
        "sentAt": { "type": "string", "format": "date-time" },
        "error": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["campaignId", "email", "status"]
    },
    "promotion_suppressions": {
      "title": "PromotionSuppression",
      "description": "Suppressed or opted-out university email addresses excluded from promotional campaigns.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "reason": { "type": "string" },
        "addedByAdminUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "addedByAdminUid"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": {
      "schema": "admins",
      "description": "Authorized administrators registry keyed by Firebase Auth UID."
    },
    "/instructors/{instructorId}": {
      "schema": "instructors",
      "description": "Instructor profiles, keyed by UID."
    },
    "/courses/{courseId}": {
      "schema": "courses",
      "description": "Public training courses."
    },
    "/registrations/{regId}": {
      "schema": "registrations",
      "description": "Course registrations."
    },
    "/mail/{mailId}": {
      "schema": "mail",
      "description": "Email queue."
    },
    "/evaluations/{evalId}": {
      "schema": "evaluations",
      "description": "User feedback records."
    },
    "/settings/{settingId}": {
      "schema": "settings",
      "description": "Global configuration documents."
    },
    "/promotion_campaigns/{campaignId}": {
      "schema": "promotion_campaigns",
      "description": "Admin-only promotional email campaigns."
    },
    "/promotion_campaigns/{campaignId}/recipients/{recipientId}": {
      "schema": "promotion_campaign_recipients",
      "description": "Per-recipient promotional email delivery status documents."
    },
    "/promotion_suppressions/{emailKey}": {
      "schema": "promotion_suppressions",
      "description": "Admin-managed promotional email suppression list."
    }
  }
}
