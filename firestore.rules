rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }
    
    function isRequestOwner() {
      return isAuthenticated() && request.auth.uid == request.resource.data.uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == "kulachet.l@bu.ac.th" ||
          request.auth.token.email.lower() == "napaporn.pu@bu.ac.th"
        )) ||
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        )
      );
    }

    function isValidInstructor(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'department']) &&
             data.email is string && data.email.matches("^[a-zA-Z0-9._%+-]+@bu\\.ac\\.th$") &&
             data.id is string && data.id.size() > 0 &&
             data.name is string && data.name.size() > 0 &&
             data.department is string && data.department.size() > 0 &&
             (!('uid' in data) || (data.uid is string && data.uid.size() > 0));
    }

    function isValidOnlineRegistration(data) {
      return (!('source' in data) || data.source == 'online') &&
             data.keys().hasAll(['courseId', 'userId', 'userName', 'userEmail', 'sequenceNumber']) &&
             data.courseId is string && data.courseId.size() > 0 && data.courseId.size() <= 128 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 256 &&
             data.userEmail is string && data.userEmail.size() > 0 && data.userEmail.size() <= 254 &&
             data.sequenceNumber is number;
    }

    function isValidWalkInRegistration(data) {
      return data.keys().hasAll(['courseId', 'source', 'userName', 'userEmail', 'sequenceNumber', 'attended', 'createdByAdminUid']) &&
             data.source == 'walk_in' &&
             data.courseId is string && data.courseId.size() > 0 && data.courseId.size() <= 128 &&
             (!('userId' in data) || data.userId == null) &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 256 &&
             data.userEmail is string && data.userEmail.matches("^[a-zA-Z0-9._%+-]+@bu\\.ac\\.th$") &&
             (!('instructorId' in data) || (data.instructorId is string && data.instructorId.size() <= 64)) &&
             (!('userDepartment' in data) || (data.userDepartment is string && data.userDepartment.size() <= 256)) &&
             (!('userPosition' in data) || (data.userPosition is string && data.userPosition.size() <= 256)) &&
             data.sequenceNumber is number &&
             data.attended is bool &&
             data.createdByAdminUid is string && data.createdByAdminUid.size() > 0 && data.createdByAdminUid.size() <= 128;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /instructors/{instructorId} {
      allow read: if isAuthenticated();
      allow create: if isValidInstructor(request.resource.data) && (
        isAdmin() || (
          (isOwner(instructorId) || isRequestOwner()) &&
          (!('englishNameVerified' in request.resource.data) || request.resource.data.englishNameVerified == false)
        )
      );
      allow update: if isValidInstructor(request.resource.data) && (
        isAdmin() || (
          (isOwner(instructorId) || isDocOwner() || (isAuthenticated() && resource.data.email == request.auth.token.email)) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['englishNameVerified']) &&
          (
            !('englishNameVerified' in resource.data) ||
            resource.data.englishNameVerified != true ||
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['englishFullName'])
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if true;
      // แก้ไข: อนุญาตให้ User ทั่วไปสามารถอัปเดตได้ "เฉพาะ" ฟิลด์จำนวนที่นั่ง (sessions, totalRegistrations, enrolledSeats) เท่านั้น
      allow update: if isAdmin() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sessions', 'totalRegistrations', 'enrolledSeats']));
      allow create, delete: if isAdmin();
    }

    match /admins/{adminUid} {
      allow read, write: if isAdmin();
    }

    match /registrations/{regId} {
      allow read: if isAuthenticated();
      allow create: if (
        isAdmin() && (
          isValidOnlineRegistration(request.resource.data) ||
          (
            isValidWalkInRegistration(request.resource.data) &&
            request.resource.data.createdByAdminUid == request.auth.uid &&
            exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId))
          )
        )
      ) || (
        isAuthenticated() &&
        isValidOnlineRegistration(request.resource.data) &&
        request.resource.data.userId == request.auth.uid &&
        (!('userEnglishNameVerified' in request.resource.data) || request.resource.data.userEnglishNameVerified == false)
      );
      // อนุญาตให้ Admin จัดการได้ทั้ง online และ walk_in; User เจ้าของรายการ online อัปเดตเฉพาะสถานะเช็คอินของตนเองได้เท่านั้น
      allow update: if (
        isAdmin() && (
          isValidOnlineRegistration(request.resource.data) ||
          (
            isValidWalkInRegistration(request.resource.data) &&
            resource.data.source == 'walk_in' &&
            (!('createdByAdminUid' in resource.data) || request.resource.data.createdByAdminUid == resource.data.createdByAdminUid)
          )
        )
      ) || (
        isAuthenticated() &&
        (!('source' in resource.data) || resource.data.source == 'online') &&
        resource.data.userId is string &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attended', 'checkInAt', 'checkInSequenceNumber', 'attendedSessions'])
      );
      // อนุญาตให้ Admin ลบได้ทั้งหมด หรือ User ลบรายการ online ของตนเอง
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        (!('source' in resource.data) || resource.data.source == 'online') &&
        resource.data.userId is string &&
        resource.data.userId == request.auth.uid
      );
    }

    match /evaluations/{evaluationId} {
      allow get, list: if (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid
      ) || isAdmin();

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    match /mail/{mailId} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }

    match /notification_records/{recordId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false; // Deny all client writes (including admins); writes permitted ONLY via backend Firebase Admin SDK
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    function isValidPromotionCampaign(data) {
      return data.keys().hasAll(['courseId', 'language', 'subject', 'registrationUrl', 'status', 'totalRecipients', 'createdByAdminUid']) &&
             data.courseId is string && data.courseId.size() > 0 && data.courseId.size() <= 128 &&
             (data.language == 'th' || data.language == 'en') &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 300 &&
             data.registrationUrl is string && data.registrationUrl.size() > 0 && data.registrationUrl.size() <= 1000 &&
             data.status in ['draft', 'ready', 'sending', 'paused', 'completed', 'completed_with_issues'] &&
             data.totalRecipients is number && data.totalRecipients >= 0 &&
             data.createdByAdminUid is string && data.createdByAdminUid.size() > 0 && data.createdByAdminUid.size() <= 128;
    }

    function isValidCampaignRecipient(data, campaignId) {
      return data.keys().hasAll(['campaignId', 'email', 'status']) &&
             data.campaignId is string && data.campaignId == campaignId &&
             data.email is string && data.email.matches("^[a-zA-Z0-9._%+-]+@bu\\.ac\\.th$") &&
             data.status in ['pending', 'processing', 'sent', 'failed', 'unknown', 'skipped'] &&
             (!('name' in data) || (data.name is string && data.name.size() <= 200)) &&
             (!('department' in data) || (data.department is string && data.department.size() <= 200));
    }

    function isValidSuppressionEntry(data) {
      return data.keys().hasAll(['email', 'addedByAdminUid']) &&
             data.email is string && data.email.matches("^[a-zA-Z0-9._%+-]+@bu\\.ac\\.th$") &&
             data.addedByAdminUid is string && data.addedByAdminUid.size() > 0 && data.addedByAdminUid.size() <= 128 &&
             (!('reason' in data) || (data.reason is string && data.reason.size() <= 300));
    }

    match /promotion_campaigns/{campaignId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() &&
        isValidPromotionCampaign(request.resource.data) &&
        request.resource.data.createdByAdminUid == request.auth.uid &&
        exists(/databases/$(database)/documents/courses/$(request.resource.data.courseId));
      allow update: if isAdmin() &&
        isValidPromotionCampaign(request.resource.data) &&
        request.resource.data.createdByAdminUid == resource.data.createdByAdminUid &&
        request.resource.data.courseId == resource.data.courseId;
      allow delete: if isAdmin() &&
        resource.data.status in ['draft', 'ready', 'paused'] &&
        (!('sentCount' in resource.data) || resource.data.sentCount == 0) &&
        (!('unknownCount' in resource.data) || resource.data.unknownCount == 0) &&
        (!('activeLockUntil' in resource.data) || resource.data.activeLockUntil == '');

      match /recipients/{recipientId} {
        allow get, list: if isAdmin();
        allow create, update: if isAdmin() && isValidCampaignRecipient(request.resource.data, campaignId);
        allow delete: if isAdmin() &&
          !(resource.data.status in ['sent', 'unknown', 'processing']) &&
          get(/databases/$(database)/documents/promotion_campaigns/$(campaignId)).data.status in ['draft', 'ready', 'paused'] &&
          (!('sentCount' in get(/databases/$(database)/documents/promotion_campaigns/$(campaignId)).data) ||
            get(/databases/$(database)/documents/promotion_campaigns/$(campaignId)).data.sentCount == 0) &&
          (!('unknownCount' in get(/databases/$(database)/documents/promotion_campaigns/$(campaignId)).data) ||
            get(/databases/$(database)/documents/promotion_campaigns/$(campaignId)).data.unknownCount == 0);
      }
    }

    match /promotion_suppressions/{emailKey} {
      allow get, list: if isAdmin();
      allow create, update: if isAdmin() &&
        isValidSuppressionEntry(request.resource.data) &&
        request.resource.data.addedByAdminUid == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
